# Five languages, one house style: UTF-8, LF, spaces, no trailing whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.eet]
# EET assembly: four spaces, and labels sit at the left margin.
indent_size = 4

[*.{csproj,props,targets,sln,slnx}]
indent_size = 2

[Makefile]
indent_style = tab
