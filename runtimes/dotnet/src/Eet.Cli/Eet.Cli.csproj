<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Eet.Cli</RootNamespace>

    <!--
      The repository driver (tools/runtimes.py) publishes this project and then invokes
      `build/dotnet/eet.exe run <file.eetb>`, so the assembly name is part of the contract
      with the harness, not a cosmetic choice.
    -->
    <AssemblyName>eet</AssemblyName>

    <IsAotCompatible>true</IsAotCompatible>
    <!-- `dotnet publish -p:PublishAot=true` needs nothing else: the SDK infers the RID. -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eet.Core\Eet.Core.csproj" />
  </ItemGroup>

</Project>
