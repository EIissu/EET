/build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Java
*.class

# .NET
bin/
obj/
*.user
.vs/

# C / C++ / CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.o
*.obj
*.exe
*.pdb
*.ilk

