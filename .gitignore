# Everything the toolchain generates lives under build/. The glob is deliberately loose:
# a mistyped or unexpanded shell variable in a build command produces directories like
# `build$name`, and those are artifacts too, not source.
/build/
/build*/

# Python
# Java
*.class

# .NET
bin/
obj/
*.user
.vs/

# C / C++ / CMake
# Assembled modules never belong in the tree; regenerate with `python tools/eet.py asm`.
*.eetb

# Editors
# --- secrets -------------------------------------------------------------------------
# The career trackers hold a Bungie API key, an Azure AD client id, and a cached Xbox
# refresh token. None of those belong in a public repository, and a refresh token is a
# live credential -- treat a leak as a compromise and revoke it, do not just delete the
# commit.
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
*.secrets.json
secrets.json
.env
.env.*
!.env.example
*.pfx
*.key
*.pem

# The Xbox token cache, if anyone points it at the working tree instead of LOCALAPPDATA.
.eet-trackers/
*.tokencache.json

# --- build output --------------------------------------------------------------------
[Dd]ebug/
[Rr]elease/
artifacts/
*.suo

# Local API response caches -- regenerable, sometimes large, occasionally contain a
# player's full match history.
.cache/
trackers/**/cache/

